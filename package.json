{
  "name": "nardy-online",
  "version": "0.1.0",
  "private": true,
  "description": "Нарды онлайн — GitHub Pages frontend with a self-hosted backend",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "build:bot-engine": "node scripts/build-long-bot-engine.js && node scripts/build-short-bot-engine.js",
    "simulate:bot-regression": "node scripts/simulate-long-bot-regression.js",
    "certify:bot-regression": "node scripts/certify-long-bot-regression.js",
    "train:long-bot-v34": "node scripts/train-certify-long-bot-v34.js",
    "review:long-bot-losses": "node scripts/review-long-bot-losses.js",
    "review:long-bot-causal": "node scripts/long-bot-causal-worker.js",
    "train:long-bot-causal-army": "node scripts/train-long-bot-causal-army.js",
    "league:long-bot-army": "node scripts/league-long-bot-army.js",
    "simulate:short-bot": "node scripts/simulate-short-bot-regression.js",
    "certify:short-bot": "node scripts/certify-short-bot-regression.js",
    "test:bot-engine": "node --test --test-concurrency=1 tests/*.test.js",
    "test": "npm run test:bot-engine",
    "build": "node scripts/build-github-pages.js"
  },
  "keywords": ["backgammon", "nardy", "long-backgammon"],
  "license": "UNLICENSED"
}
